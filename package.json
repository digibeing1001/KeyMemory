{
  "name": "keymemory",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "private": true,
  "description": "KeyMemory - local-first agent memory layer and MCP server",
  "homepage": "https://github.com/digibeing1001/KeyMemory",
  "bin": {
    "keymemory": "./bin/keymemory.js",
    "keymemory-mcp": "./bin/keymemory-mcp.js",
    "keymemory-ui": "./bin/keymemory-ui.js"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @keymemory/server run dev",
    "dev:web": "pnpm --filter @keymemory/web run dev",
    "dev:cli": "pnpm --filter keymemory-mcp run dev:cli",
    "cli": "pnpm --filter keymemory-mcp run cli",
    "start:mcp": "node bin/keymemory-mcp.js",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --filter @keymemory/shared build && pnpm -r run typecheck",
    "eval:memory": "node scripts/eval-memory.mjs",
    "perf:memory": "node scripts/perf-memory.mjs",
    "smoke": "node scripts/smoke-keymemory.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:loop": "node scripts/smoke-loop-harness.mjs",
    "loop:audit": "node scripts/loop-readiness-audit.mjs",
    "smoke:launchers": "node scripts/smoke-launchers.mjs",
    "release:check": "node scripts/release-check.mjs",
    "postinstall": "pnpm build",
    "setup": "node bin/install.js",
    "update": "node update-keymemory.js",
    "download-model": "node scripts/download-model.js",
    "install:local": "pnpm build && pnpm --filter keymemory-mcp link",
    "install-memory": "node install-default-memory.js",
    "start:ui": "node start-ui.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "keymemory-mcp": "link:packages/server"
  },
  "pnpm": {
    "overrides": {
      "keymemory-mcp": "link:packages/server"
    }
  }
}
