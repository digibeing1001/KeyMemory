{
  "name": "keymemory-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "KeyMemory - local-first agent memory layer and MCP server",
  "keywords": [
    "mcp",
    "memory",
    "ai",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/digibeing1001/KeyMemory"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "keymemory": "./dist/cli.js",
    "keymemory-mcp": "./dist/mcp-server.js",
    "keymemory-setup": "./dist/setup.js"
  },
  "files": [
    "dist",
    "models",
    "presets"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:cli": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:mcp": "node dist/mcp-server.js",
    "cli": "node dist/cli.js",
    "download-model": "node ../../scripts/download-model.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^9.1.3",
    "@keymemory/shared": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.9.0",
    "commander": "^14.0.3",
    "fastify": "^5.3.0",
    "onnxruntime-node": "^1.21.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
